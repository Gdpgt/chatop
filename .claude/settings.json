  "permissions": {
    "deny": [
      "Edit(/docs/oc/**)",
      "Edit(/src/app/**)",
      "Edit(/src/assets/**)",
      "Edit(/src/environments/**)",
      "Edit(/src/*.ts)",
      "Edit(/src/*.html)",
      "Edit(/src/*.scss)",
